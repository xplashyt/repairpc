# ---------------------------------------------------------------------------
# Wompi — pasarela de pagos (https://comercios.wompi.co)
# ---------------------------------------------------------------------------

# PÚBLICA. Se incrusta en el JavaScript del navegador; es segura de exponer.
# Define además el ambiente: si empieza con pub_test_ se usa el sandbox
# (sandbox.wompi.co), cualquier otro valor apunta a producción.
# Panel de Wompi -> Desarrolladores -> Llaves.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=

# SECRETA. Crea la transacción desde el servidor. Nunca la expongas.
# Panel de Wompi -> Desarrolladores -> Llaves.
WOMPI_PRIVATE_KEY=

# SECRETA. Firma cada transacción (SHA-256 sobre referencia + monto + moneda).
# Panel de Wompi -> Desarrolladores -> Llaves -> Secreto de integridad.
WOMPI_INTEGRITY_SECRET=

# SECRETA. Verifica que los webhooks vengan de verdad de Wompi.
# Panel de Wompi -> Desarrolladores -> Eventos -> Secreto de eventos.
WOMPI_EVENTS_SECRET=

# ---------------------------------------------------------------------------
# Resend — envío de correos (https://resend.com)
# ---------------------------------------------------------------------------

# SECRETA. resend.com -> API Keys -> Create API Key.
RESEND_API_KEY=

# Remitente. Debe ser un dominio verificado en Resend.
# Para probar sirve "Guías PC <onboarding@resend.dev>", pero con ese
# remitente Resend solo permite enviar al correo dueño de la cuenta.
ORDER_FROM_EMAIL=

# Tu correo: aquí llega el aviso de cada venta.
ORDER_NOTIFY_EMAIL=

# ---------------------------------------------------------------------------
# Entrega de las guías
# ---------------------------------------------------------------------------

# SECRETA. Firma los enlaces de descarga (HMAC-SHA256). Cadena aleatoria
# larga; si la cambias, los enlaces ya enviados dejan de funcionar.
# Genérala con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DOWNLOAD_SIGNING_SECRET=

# PÚBLICA. URL base del sitio; se usa para armar el enlace absoluto de
# descarga que va en el correo. En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
